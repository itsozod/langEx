# Keeps React Native's XHR-based `fetch` polyfill instead of letting Expo SDK 57 replace
# `globalThis.fetch` with the native `expo/fetch`. Required by the avatar upload in
# src/screens/onboarding/api.ts, which reads a local `file://` asset URI: `expo/fetch` passes the
# URL straight to native networking, and OkHttp does not serve `file://` on Android.
# See node_modules/expo/src/winter/runtime.native.ts. Do not delete as unused config.
EXPO_PUBLIC_USE_RN_FETCH=1
