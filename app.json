{
  "expo": {
    "name": "LangEx",
    "slug": "langEx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/langex-app-icon.png",
    "scheme": "langex",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/langex-app-icon.png",
      "bundleIdentifier": "com.ozod2905.langEx"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#181220",
        "foregroundImage": "./assets/images/langex-adaptive-foreground.png",
        "monochromeImage": "./assets/images/langex-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ozod2905.langEx"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/langex-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#181220",
          "image": "./assets/images/langex-splash-mark.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#181220",
            "image": "./assets/images/langex-splash-mark.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LangEx to access your photos so you can choose a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#534AB7",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "97620e52-21a6-4795-9387-4eb2b44956f1"
      }
    },
    "owner": "ozod2905"
  }
}
